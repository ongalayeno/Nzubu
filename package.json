{
  "name": "nzubu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/domain/*.test.ts src/offlineMission.test.ts src/components/client/AvailabilityCalendar.test.tsx src/components/client/LiveClientExperience.test.tsx src/components/partner/LivePartnerDashboard.test.tsx src/components/agent/LiveAgentWorkspace.test.tsx src/components/admin/LiveAdminDashboard.test.tsx server/brevo.test.ts",
    "api": "tsx server/index.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run api\"",
    "test:integration": "tsx --test server/integration.test.ts server/auth.integration.test.ts",
    "test:load": "node scripts/smoke-load.mjs",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
